{
  "homepage": "https://YOUR_USERNAME.github.io/TrabGrupoHabSoc",
  "name": "parcel-react-client-starter",
  "private": true,
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "start": "concurrently \"npx @tailwindcss/cli -i ./styles.css -o ./src/tailwind.css --watch\" \"parcel src/index.html\"",
    "build": "npx @tailwindcss/cli -i ./styles.css -o ./src/tailwind.css && parcel build src/index.html --public-url /TrabGrupoHabSoc/",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@parcel/resolver-glob": "^2.16.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.5",
    "gh-pages": "^6.3.0",
    "parcel": "^2.14.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  }
}
